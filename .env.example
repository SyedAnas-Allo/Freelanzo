# Copy to .env.local and fill values
# Local: run `npx supabase start` then `npx supabase status -o env`
#   Map ANON_KEY → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   Map SERVICE_ROLE_KEY → SUPABASE_SECRET_KEY
# Cloud: Project Settings → API Keys → Publishable and secret API keys
#   https://supabase.com/dashboard/project/_/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional geocoder overrides. The defaults use the public OpenStreetMap
# Nominatim service and are suitable only for moderate, policy-compliant use.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Freelanzo/0.1 (replace-with-your-production-url-or-contact-email)

# Google OAuth: enable in Supabase Auth → Providers → Google
# Add authorized redirect: {SITE_URL}/auth/callback
# Also add Supabase callback URL from the Google provider settings
